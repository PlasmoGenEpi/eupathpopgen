nextflow_process {

    name "Test Process ADD_POPULATION_COLUMN"
    script "modules/local/add_population_column/main.nf"
    process "ADD_POPULATION_COLUMN"
    tag "modules"
    tag "modules_local"
    tag "add_population_column"

    test("Should resolve the population label from the lookup") {

        when {
            process {
                """
                input[0] = ['popidx_001', file(params.pipelines_testdata_base_path + 'testdata/popidx_001.naive.coi_table.tsv', checkIfExists: true)]
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/population_index_lookup.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.labeled_table.get(0)).readLines()[0] == "population\tcoi_method\tspecimen_name\tcoi" },
                { assert path(process.out.labeled_table.get(0)).readLines()[1].startsWith("Laos_201701-01\t") },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("Should use the index as the label when the lookup is empty") {

        when {
            process {
                """
                input[0] = ['all', file(params.pipelines_testdata_base_path + 'testdata/popidx_001.naive.coi_table.tsv', checkIfExists: true)]
                input[1] = file("${projectDir}/assets/empty_population_index_lookup.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.labeled_table.get(0)).readLines()[1].startsWith("all\t") },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("Should fail when the index is missing from the lookup") {

        when {
            process {
                """
                input[0] = ['popidx_999', file(params.pipelines_testdata_base_path + 'testdata/popidx_001.naive.coi_table.tsv', checkIfExists: true)]
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/population_index_lookup.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.failed
        }
    }

    test("Stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = ['popidx_001', file(params.pipelines_testdata_base_path + 'testdata/popidx_001.naive.coi_table.tsv', checkIfExists: true)]
                input[1] = file(params.pipelines_testdata_base_path + 'testdata/population_index_lookup.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
