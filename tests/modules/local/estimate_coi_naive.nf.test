nextflow_process {

    name "Test Process ESTIMATE_COI_NAIVE"
    script "modules/local/estimate_coi_naive/main.nf"
    process "ESTIMATE_COI_NAIVE"
    tag "modules"
    tag "modules_local"
    tag "estimate_coi_naive"

    test("Should estimate COI with the integer method") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/popidx_001.allele_table.tsv.gz', checkIfExists: true)
                input[1] = 'integer_method'
                input[2] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.coi_table.get(0)[0] == 'popidx_001' },
                { assert path(process.out.coi_table.get(0)[1]).readLines()[0] == "specimen_name\tcoi" },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("Should estimate COI with the quantile method") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/popidx_001.allele_table.tsv.gz', checkIfExists: true)
                input[1] = 'quantile_method'
                input[2] = 0.5
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("Should fail with an unknown method") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/popidx_001.allele_table.tsv.gz', checkIfExists: true)
                input[1] = 'bad_method'
                input[2] = 1
                """
            }
        }

        then {
            assert process.failed
        }
    }

    test("Stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/popidx_001.allele_table.tsv.gz', checkIfExists: true)
                input[1] = 'integer_method'
                input[2] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
