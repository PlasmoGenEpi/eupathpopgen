nextflow_process {

    name "Test Process COUNT_SAMPLES_BY_COI"
    script "modules/local/count_samples_by_coi/main.nf"
    process "COUNT_SAMPLES_BY_COI"
    tag "modules"
    tag "modules_local"
    tag "count_samples_by_coi"

    test("Should count samples per COI and prepend the method") {

        when {
            process {
                """
                input[0] = ['popidx_001', 'naive', file(params.pipelines_testdata_base_path + 'testdata/popidx_001.naive.coi_table.tsv', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.sample_count_per_coi.get(0)[1]).readLines()[0].startsWith("coi_method\t") },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("Stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = ['popidx_001', 'naive', file(params.pipelines_testdata_base_path + 'testdata/popidx_001.naive.coi_table.tsv', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
