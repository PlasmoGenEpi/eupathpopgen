nextflow_process {

    name "Test Process RUN_MOIRE"
    script "modules/local/run_moire/main.nf"
    process "RUN_MOIRE"
    tag "modules"
    tag "modules_local"
    tag "run_moire"

    // Keep MCMC tractable; same reduced settings as conf/test_full.config
    config "tests/modules/local/run_moire.nextflow.config"

    test("Should run MOIRE") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/allele_table.tsv', checkIfExists: true)
                """
            }
        }

        // MCMC output is stochastic, so only headers and file names are checked
        then {
            assertAll(
                { assert process.success },
                { assert process.out.coi_summary.get(0)[0] == 'allele_table' },
                { assert path(process.out.allele_freq_summary.get(0)[1]).readLines()[0].startsWith("target_name\tseq\tfreq") },
                { assert snapshot(
                    process.out.coi_summary.collect { prefix, f -> [prefix, file(f).name] },
                    process.out.he_summary.collect { prefix, f -> [prefix, file(f).name] },
                    process.out.allele_freq_summary.collect { prefix, f -> [prefix, file(f).name] },
                    process.out.relatedness_summary.collect { prefix, f -> [prefix, file(f).name] },
                    process.out.effective_coi_summary.collect { prefix, f -> [prefix, file(f).name] },
                    process.out.convergence_summary.collect { prefix, f -> [prefix, file(f).name] },
                    process.out.versions
                ).match() }
            )
        }
    }

    test("Stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/allele_table.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
