{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/eupathpopgen/master/nextflow_schema.json",
    "title": "nf-core/eupathpopgen pipeline parameters",
    "description": "Pipeline for generating population genetic metrics from microhaplotype data of eukaryotic pathogens (e.g. Plasmodium). Designed for infections containing multiple genetically distinct clones, the pipeline estimates complexity of infection (COI), identity by descent (IBD), allele frequencies, within-host relatedness, and other population genetic metrics.",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": ["allele_table", "outdir"],
            "properties": {
                "allele_table": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/tab-separated-values",
                    "pattern": "^\\S+$",
                    "description": "Path to allele table TSV (specimen_name, target_name, seq, reads).",
                    "help_text": "Canonical PGEcore allele table. Columns: specimen_name, target_name, seq, and usually reads. See the PGEcore input-formats vignette.",
                    "fa_icon": "fas fa-file-csv"
                },
                "population_map": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Optional TSV mapping specimen_name to population for stratified analyses.",
                    "help_text": "When provided, the allele table is split by population before metric estimation. Requires columns specimen_name and population.",
                    "fa_icon": "fas fa-users"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
                    "fa_icon": "fas fa-folder-open"
                },
                "email": {
                    "type": "string",
                    "description": "Email address for completion summary.",
                    "fa_icon": "fas fa-envelope",
                    "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$"
                },
                "multiqc_title": {
                    "type": "string",
                    "description": "MultiQC report title. Printed as page header, used for filename if not otherwise specified.",
                    "fa_icon": "fas fa-file-signature"
                },
                "input": {
                    "type": "string",
                    "description": "Unused legacy parameter retained for template compatibility.",
                    "hidden": true,
                    "fa_icon": "fas fa-file-csv"
                }
            }
        },
        "analysis_options": {
            "title": "Analysis options",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "description": "Select which population-genetic estimates to produce and how to compute them.",
            "properties": {
                "coi_method": {
                    "type": "string",
                    "default": "naive",
                    "enum": ["naive", "moire"],
                    "description": "Method for complexity of infection (COI) estimation.",
                    "help_text": "Always estimated. Use naive or moire. Additional methods may be added later. If moire is also needed for allele frequencies or within-host relatedness, MOIRE still runs only once.",
                    "fa_icon": "fas fa-users-cog"
                },
                "naive_coi_method": {
                    "type": "string",
                    "default": "integer_method",
                    "enum": ["integer_method", "quantile_method"],
                    "description": "Naive COI estimator when --coi_method is naive.",
                    "fa_icon": "fas fa-users-cog"
                },
                "naive_coi_threshold": {
                    "type": "number",
                    "default": 1,
                    "description": "Integer index (integer_method) or quantile in 0-1 (quantile_method) for naive COI.",
                    "fa_icon": "fas fa-users-cog"
                },
                "skip_allele_frequencies": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip allele-frequency estimation (currently via MOIRE).",
                    "fa_icon": "fas fa-forward"
                },
                "skip_within_host_relatedness": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip within-host relatedness estimation (currently via MOIRE).",
                    "fa_icon": "fas fa-forward"
                },
                "skip_between_host_relatedness": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip between-host relatedness / IBD estimation (currently via Dcifer).",
                    "fa_icon": "fas fa-forward"
                },
                "skip_multiqc": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip MultiQC report generation."
                },
                "moire_seed": { "type": "integer", "description": "MOIRE RNG seed.", "hidden": true },
                "moire_burnin": { "type": "integer", "description": "MOIRE MCMC burn-in iterations.", "hidden": true },
                "moire_samples_per_chain": { "type": "integer", "description": "MOIRE samples per chain.", "hidden": true },
                "moire_n_chains": { "type": "integer", "description": "MOIRE number of independent MCMC chains.", "hidden": true },
                "moire_threads": { "type": "integer", "description": "MOIRE threads for parallel chains.", "hidden": true },
                "moire_thin": { "type": "integer", "description": "MOIRE thinning interval.", "hidden": true },
                "moire_allow_relatedness": { "type": "boolean", "description": "MOIRE allow within-host relatedness.", "hidden": true },
                "moire_verbose": { "type": "boolean", "description": "MOIRE verbose logging.", "hidden": true },
                "dcifer_rnull": { "type": "number", "description": "Dcifer null relatedness for hypothesis testing.", "hidden": true },
                "dcifer_alpha": { "type": "number", "description": "Dcifer alpha for hypothesis testing.", "hidden": true },
                "dcifer_use_estm": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use dcifer::ibdEstM instead of ibdPair.",
                    "hidden": true
                }
            }
        },
        "institutional_config_options": {
            "title": "Institutional config options",
            "type": "object",
            "fa_icon": "fas fa-university",
            "description": "Parameters used to describe centralised config profiles. These should not be edited.",
            "properties": {
                "custom_config_version": {
                    "type": "string",
                    "description": "Git commit id for Institutional configs.",
                    "default": "master",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "custom_config_base": {
                    "type": "string",
                    "description": "Base directory for Institutional configs.",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_name": {
                    "type": "string",
                    "description": "Institutional config name.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_description": {
                    "type": "string",
                    "description": "Institutional config description.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_contact": {
                    "type": "string",
                    "description": "Institutional config contact information.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_url": {
                    "type": "string",
                    "description": "Institutional config URL link.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "Method used to save pipeline results to output directory.",
                    "fa_icon": "fas fa-copy",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "hidden": true
                },
                "email_on_fail": {
                    "type": "string",
                    "description": "Email address for completion summary, only when pipeline fails.",
                    "fa_icon": "fas fa-exclamation-triangle",
                    "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$",
                    "hidden": true
                },
                "plaintext_email": {
                    "type": "boolean",
                    "description": "Send plain-text email instead of HTML.",
                    "fa_icon": "fas fa-remove-format",
                    "hidden": true
                },
                "max_multiqc_email_size": {
                    "type": "string",
                    "description": "File size limit when attaching MultiQC reports to summary emails.",
                    "pattern": "^\\d+(\\.\\d+)?\\.?\\s*(K|M|G|T)?B$",
                    "default": "25.MB",
                    "fa_icon": "fas fa-file-upload",
                    "hidden": true
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "description": "Do not use coloured log outputs.",
                    "fa_icon": "fas fa-palette",
                    "hidden": true
                },
                "multiqc_config": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Custom config file to supply to MultiQC.",
                    "fa_icon": "fas fa-cog",
                    "hidden": true
                },
                "multiqc_logo": {
                    "type": "string",
                    "description": "Custom logo file to supply to MultiQC.",
                    "fa_icon": "fas fa-image",
                    "hidden": true
                },
                "multiqc_methods_description": {
                    "type": "string",
                    "description": "Custom MultiQC yaml file containing HTML including a methods description.",
                    "fa_icon": "fas fa-cog"
                },
                "validate_params": {
                    "type": "boolean",
                    "description": "Boolean whether to validate parameters against the schema at runtime",
                    "default": true,
                    "fa_icon": "fas fa-check-square",
                    "hidden": true
                },
                "pipelines_testdata_base_path": {
                    "type": "string",
                    "fa_icon": "far fa-check-circle",
                    "description": "Base URL or local path to location of pipeline test dataset files",
                    "default": "https://raw.githubusercontent.com/nf-core/test-datasets/",
                    "hidden": true
                },
                "trace_report_suffix": {
                    "type": "string",
                    "fa_icon": "far calendar",
                    "description": "Suffix to add to the trace report filename.",
                    "hidden": true
                },
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Display the help message."
                },
                "help_full": {
                    "type": "boolean",
                    "description": "Display the full detailed help message."
                },
                "show_hidden": {
                    "type": "boolean",
                    "description": "Display hidden parameters in the help message."
                },
                "pgecore_git_ref": {
                    "type": "string",
                    "description": "Git commit/tag of PlasmoGenEpi/PGEcore to install when not using pgecore_local.",
                    "hidden": true
                },
                "pgecore_git_repo": {
                    "type": "string",
                    "description": "GitHub repo path for PGEcore.",
                    "hidden": true
                },
                "pgecore_local": {
                    "type": "boolean",
                    "description": "Use local PGEcore checkout via PGECORE_HOME.",
                    "hidden": true
                },
                "pgecore_home": {
                    "type": "string",
                    "description": "Path to local PGEcore source checkout.",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        { "$ref": "#/$defs/input_output_options" },
        { "$ref": "#/$defs/analysis_options" },
        { "$ref": "#/$defs/institutional_config_options" },
        { "$ref": "#/$defs/generic_options" }
    ]
}
