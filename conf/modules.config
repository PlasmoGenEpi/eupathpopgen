/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Index → split → parallel estimates → label → concat.
    Only final concatenated summaries (and population inputs) are published.
----------------------------------------------------------------------------------------
*/

process {

    // Do not publish intermediate process outputs by default (drugres parity)
    publishDir = [
        enabled: false
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }

    withName: 'RUN_MOIRE' {
        ext.args = { [
            params.moire_seed                 != null ? "--seed ${params.moire_seed}" : '',
            params.moire_allow_relatedness    != null ? "--allow_relatedness ${params.moire_allow_relatedness}" : '',
            params.moire_burnin               != null ? "--burnin ${params.moire_burnin}" : '',
            params.moire_samples_per_chain    != null ? "--samples_per_chain ${params.moire_samples_per_chain}" : '',
            params.moire_n_chains             != null ? "--n_chains ${params.moire_n_chains}" : '',
            params.moire_threads              != null ? "--threads ${params.moire_threads}" : '',
            params.moire_thin                 != null ? "--thin ${params.moire_thin}" : '',
            params.moire_verbose              != null ? "--verbose ${params.moire_verbose}" : '',
            params.moire_eps_pos_alpha        != null ? "--eps_pos_alpha ${params.moire_eps_pos_alpha}" : '',
            params.moire_eps_pos_beta         != null ? "--eps_pos_beta ${params.moire_eps_pos_beta}" : '',
            params.moire_eps_neg_alpha        != null ? "--eps_neg_alpha ${params.moire_eps_neg_alpha}" : '',
            params.moire_eps_neg_beta         != null ? "--eps_neg_beta ${params.moire_eps_neg_beta}" : '',
            params.moire_r_alpha              != null ? "--r_alpha ${params.moire_r_alpha}" : '',
            params.moire_r_beta               != null ? "--r_beta ${params.moire_r_beta}" : '',
            params.moire_mean_coi_shape       != null ? "--mean_coi_shape ${params.moire_mean_coi_shape}" : '',
            params.moire_mean_coi_scale       != null ? "--mean_coi_scale ${params.moire_mean_coi_scale}" : '',
            params.moire_max_eps_pos          != null ? "--max_eps_pos ${params.moire_max_eps_pos}" : '',
            params.moire_max_eps_neg          != null ? "--max_eps_neg ${params.moire_max_eps_neg}" : '',
            params.moire_record_latent_genotypes != null ? "--record_latent_genotypes ${params.moire_record_latent_genotypes}" : '',
            params.moire_pt_chains            != null ? "--pt_chains ${params.moire_pt_chains}" : '',
            params.moire_pt_grad_lower        != null ? "--pt_grad_lower ${params.moire_pt_grad_lower}" : '',
            params.moire_pt_num_threads       != null ? "--pt_num_threads ${params.moire_pt_num_threads}" : '',
            params.moire_adapt_temp           != null ? "--adapt_temp ${params.moire_adapt_temp}" : '',
            params.moire_max_runtime          != null ? "--max_runtime ${params.moire_max_runtime}" : ''
        ].findAll { it }.join(' ') }
    }

    withName: 'CONCAT_COI_TABLE|CONCAT_SAMPLE_COUNT|CONCAT_COI_SUMMARY|CONCAT_EFFECTIVE_COI|CONCAT_CONVERGENCE|CONCAT_ALLELE_FREQ|CONCAT_PER_LOCUS' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            enabled: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CONCAT_HE' {
        publishDir = [
            path: { "${params.outdir}/raw_outputs" },
            mode: params.publish_dir_mode,
            enabled: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CONCAT_WITHIN_HOST|CONCAT_BETWEEN_HOST' {
        publishDir = [
            path: { "${params.outdir}/relatedness" },
            mode: params.publish_dir_mode,
            enabled: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_ALLELE_TABLE' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info/pmo" },
            mode: params.publish_dir_mode,
            enabled: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_POPULATION_MAP_FROM_PMO' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info/pmo" },
            mode: params.publish_dir_mode,
            enabled: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'INDEX_POPULATION_ASSIGNMENT' {
        publishDir = [
            path: { "${params.outdir}/populations" },
            mode: params.publish_dir_mode,
            enabled: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPLIT_ALLELE_TABLE_BY_POP' {
        publishDir = [
            [
                path: { "${params.outdir}/populations" },
                mode: params.publish_dir_mode,
                enabled: true,
                pattern: '*.allele_table.tsv.gz'
            ],
            [
                path: { "${params.outdir}" },
                mode: params.publish_dir_mode,
                enabled: true,
                pattern: 'unassigned_specimens.txt'
            ]
        ]
    }
}
