/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PGEcore pin and package bridge settings
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Until PGEcore is on conda, modules install from GitHub at pgecore_git_ref.
    Use -profile pgecore_local with PGECORE_HOME for a local source checkout.
----------------------------------------------------------------------------------------
*/

params {
    // Pin to PlasmoGenEpi/PGEcore develop tip used for CLI contract freeze.
    // Update this SHA when bumping the GitHub bridge; swap to conda when published.
    pgecore_git_ref = '3c93fe8f5f7ef329b723e8160d219c3a28fe3ca5'
    pgecore_git_repo = 'PlasmoGenEpi/PGEcore'
    pgecore_local    = false
    pgecore_home     = null
}

/*
    Publish layout (v1), by estimate:
      ${outdir}/COI/naive/ or COI/moire/
      ${outdir}/allele_frequencies/
      ${outdir}/relatedness/within_host/
      ${outdir}/relatedness/between_host/
      ${outdir}/per_locus_summaries/allele_counts/
      ${outdir}/per_locus_summaries/popgen/
      ${outdir}/populations/
      ${outdir}/multiqc/
      ${outdir}/pipeline_info/
*/