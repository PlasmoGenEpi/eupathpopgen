/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PGEcore settings
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PGEcore comes from bioconda (r-pgecore) via each module's environment / container.
    Use -profile pgecore_local with PGECORE_HOME for a local source checkout.
----------------------------------------------------------------------------------------
*/

params {
    pgecore_local    = false
    pgecore_home     = null
}

/*
    Publish layout (v1), flat under ${outdir}/:
      coi_table.tsv / coi_summary.tsv / sample_count_per_coi.tsv
      allele_freq_summary.tsv / he_summary.tsv
      per_locus_summary.tsv
      relatedness/within_host.tsv + relatedness/between_host.tsv
      raw_outputs/he_summary.tsv
      populations/
      multiqc/
      pipeline_info/
*/
