/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run nf-core/eupathpopgen -profile test,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal allele-table test dataset to check pipeline function'

    allele_table = "${params.pipelines_testdata_base_path}testdata/allele_table.tsv"

    // Fast path: naive COI only (no MOIRE / Dcifer); locus summaries still run
    coi_method                    = 'naive'
    skip_allele_frequencies       = true
    skip_within_host_relatedness  = true
    skip_between_host_relatedness = true
}
