/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 8,
        memory: '32.GB',
        time: '8.h'
    ]
}

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test with allele table, population map, and reduced MOIRE iterations'

    allele_table          = "${params.pipelines_testdata_base_path}testdata/allele_table.tsv"
    population_assignment = "${params.pipelines_testdata_base_path}testdata/population_assignment.tsv"

    coi_method                    = 'moire'
    skip_allele_frequencies       = false
    skip_within_host_relatedness  = false
    skip_between_host_relatedness = false

    // Keep MOIRE tractable for CI / smoke tests
    moire_burnin            = 50
    moire_samples_per_chain = 20
    moire_n_chains          = 2
    moire_seed              = 1
}
