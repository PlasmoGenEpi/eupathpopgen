/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local PGEcore development profile (-profile pgecore_local)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Requires environment variable PGECORE_HOME pointing at a PGEcore source checkout.
    Installs that checkout into ${PGECORE_HOME}/.r_libs (once, under a lock) and prefers
    exec/ CLIs from the checkout over the conda r-pgecore package.

    Example:
      export PGECORE_HOME=/path/to/PGEcore
      nextflow run . -profile docker,pgecore_local,test --outdir results
----------------------------------------------------------------------------------------
*/
params {
    pgecore_local = true
    pgecore_home  = System.getenv('PGECORE_HOME')
}

if (!params.pgecore_home) {
    throw new IllegalArgumentException(
        "Profile pgecore_local requires PGECORE_HOME to point at a PGEcore source checkout."
    )
}

def pgecoreHome = params.pgecore_home

process {
    withLabel: 'pgecore' {
        beforeScript = {
            """
            export PGECORE_HOME='${pgecoreHome}'
            if [ ! -f "\${PGECORE_HOME}/DESCRIPTION" ]; then
                echo "ERROR: PGECORE_HOME does not look like a PGEcore package: \${PGECORE_HOME}" >&2
                exit 1
            fi
            mkdir -p "\${PGECORE_HOME}/.r_libs"
            export R_LIBS_USER="\${PGECORE_HOME}/.r_libs:\${R_LIBS_USER:-}"

            # Serialize installs across parallel popidx tasks (macOS-safe mkdir lock).
            lockdir="\${PGECORE_HOME}/.r_libs/.install.lock.d"
            i=0
            while ! mkdir "\${lockdir}" 2>/dev/null; do
                i=\$((i + 1))
                if [ "\${i}" -gt 600 ]; then
                    echo "ERROR: timed out waiting for PGEcore install lock at \${lockdir}" >&2
                    exit 1
                fi
                sleep 1
            done
            trap 'rmdir "\${lockdir}" 2>/dev/null || true' EXIT

            Rscript -e '
              home <- Sys.getenv("PGECORE_HOME")
              libs <- file.path(home, ".r_libs")
              Sys.setenv(R_LIBS_USER = libs)
              .libPaths(c(libs, .libPaths()))
              if (!requireNamespace("remotes", quietly = TRUE)) {
                install.packages("remotes", lib = libs, repos = "https://cloud.r-project.org")
              }
              need <- !requireNamespace("PGEcore", quietly = TRUE)
              if (!need) {
                src_mtime <- file.info(file.path(home, "DESCRIPTION"))\$mtime
                pkg_dir <- tryCatch(find.package("PGEcore"), error = function(e) NA_character_)
                need <- is.na(pkg_dir) || isTRUE(src_mtime > file.info(pkg_dir)\$mtime)
              }
              if (need) {
                message("Installing local PGEcore from ", home, " into ", libs)
                remotes::install_local(home, lib = libs, upgrade = "never", dependencies = TRUE, force = TRUE)
              } else {
                message("Using existing PGEcore install: ", as.character(utils::packageVersion("PGEcore")))
              }
            '
            """
        }
        containerOptions = {
            workflow.containerEngine == 'docker' ? "-v ${pgecoreHome}:${pgecoreHome}" :
            (workflow.containerEngine in ['singularity', 'apptainer'] ? "--bind ${pgecoreHome}:${pgecoreHome}" : '')
        }
    }
}
