/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local PGEcore development profile (-profile pgecore_local)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Requires environment variable PGECORE_HOME pointing at a PGEcore source checkout.
    Installs (or reinstalls) that checkout into ${PGECORE_HOME}/.r_libs and prefers
    exec/ CLIs from the checkout over the GitHub-pinned package in the container.

    Example:
      export PGECORE_HOME=/path/to/PGEcore
      nextflow run . -profile docker,pgecore_local,test --outdir results
----------------------------------------------------------------------------------------
*/
// TODO: remove this as an option when PGEcore on conda
params {
    pgecore_local = true
    pgecore_home  = System.getenv('PGECORE_HOME')
}

if (!params.pgecore_home) {
    throw new IllegalArgumentException(
        "Profile pgecore_local requires PGECORE_HOME to point at a PGEcore source checkout."
    )
}

def pgecoreHome = params.pgecore_home

process {
    withLabel: 'pgecore' {
        beforeScript = {
            """
            export PGECORE_HOME='${pgecoreHome}'
            if [ ! -f "\${PGECORE_HOME}/DESCRIPTION" ]; then
                echo "ERROR: PGECORE_HOME does not look like a PGEcore package: \${PGECORE_HOME}" >&2
                exit 1
            fi
            mkdir -p "\${PGECORE_HOME}/.r_libs"
            export R_LIBS_USER="\${PGECORE_HOME}/.r_libs:\${R_LIBS_USER:-}"
            Rscript -e "if (!requireNamespace('remotes', quietly=TRUE)) install.packages('remotes', repos='https://cloud.r-project.org')"
            Rscript -e "remotes::install_local(Sys.getenv('PGECORE_HOME'), upgrade='never', dependencies=TRUE, force=TRUE)"
            """
        }
        containerOptions = {
            workflow.containerEngine == 'docker' ? "-v ${pgecoreHome}:${pgecoreHome}" :
            (workflow.containerEngine in ['singularity', 'apptainer'] ? "--bind ${pgecoreHome}:${pgecoreHome}" : '')
        }
    }
}
