/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running PMO-based tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run nf-core/eupathpopgen -profile test_pmo,<docker/singularity/conda> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test PMO profile'
    config_profile_description = 'Minimal test dataset starting from PMO input'

    pmo                   = "${params.pipelines_testdata_base_path}testdata/example_PMO.json"
    pmo_population_fields = 'collection_country'

    // Fast path: naive COI only (no MOIRE / Dcifer); target summaries still run
    coi_method                    = 'naive'
    skip_allele_frequencies       = true
    skip_within_host_relatedness  = true
    skip_between_host_relatedness = true
}
