/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Plasmodium-validated defaults (-profile plasmodium)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Plasmodium'
    config_profile_description = 'Plasmodium-validated defaults for microhaplotype popgen estimates'

    coi_method                    = 'naive'
    naive_coi_method              = 'integer_method'
    naive_coi_threshold           = 1
    skip_allele_frequencies       = false
    skip_within_host_relatedness  = false
    skip_between_host_relatedness = false
}
