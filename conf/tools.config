/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Tool-specific options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Optional flags passed to PGEcore wrappers via ext.args.
    A null param leaves the wrapper's own default in place.
----------------------------------------------------------------------------------------
*/

params {
    // MOIRE (PGEcore moire_wrapper); threads come from task.cpus
    moire_seed                    = null // default in script is unset (non-deterministic)
    moire_allow_relatedness       = null // default in script is true
    moire_burnin                  = null // default in script is 10000
    moire_samples_per_chain       = null // default in script is 1000
    moire_n_chains                = null // default in script is 3
    moire_thin                    = null // default in script is 1
    moire_verbose                 = null // default in script is false
    moire_eps_pos_alpha           = null // default in script is 1
    moire_eps_pos_beta            = null // default in script is 1
    moire_eps_neg_alpha           = null // default in script is 1
    moire_eps_neg_beta            = null // default in script is 1
    moire_r_alpha                 = null // default in script is 1
    moire_r_beta                  = null // default in script is 1
    moire_mean_coi_shape          = null // default in script is 0.1
    moire_mean_coi_scale          = null // default in script is 10
    moire_max_eps_pos             = null // default in script is 2
    moire_max_eps_neg             = null // default in script is 2
    moire_record_latent_genotypes = null // default in script is false
    moire_pt_chains               = null // default in script is 1
    moire_pt_grad_lower           = null // default in script is 0
    moire_pt_num_threads          = null // default in script is 1
    moire_adapt_temp              = null // default in script is true
    moire_max_runtime             = null // default in script is Inf

    // Dcifer (PGEcore dcifer_ibd_wrapper); threads come from task.cpus
    dcifer_rnull                  = null // default in script is 0
    dcifer_alpha                  = null // default in script is 0.05
    dcifer_use_estm               = false
}

process {
    withName: 'RUN_MOIRE' {
        ext.args = { [
            params.moire_seed                    != null ? "--seed ${params.moire_seed}" : "",
            params.moire_allow_relatedness       != null ? "--allow_relatedness ${params.moire_allow_relatedness}" : "",
            params.moire_burnin                  != null ? "--burnin ${params.moire_burnin}" : "",
            params.moire_samples_per_chain       != null ? "--samples_per_chain ${params.moire_samples_per_chain}" : "",
            params.moire_n_chains                != null ? "--n_chains ${params.moire_n_chains}" : "",
            params.moire_thin                    != null ? "--thin ${params.moire_thin}" : "",
            params.moire_verbose                 != null ? "--verbose ${params.moire_verbose}" : "",
            params.moire_eps_pos_alpha           != null ? "--eps_pos_alpha ${params.moire_eps_pos_alpha}" : "",
            params.moire_eps_pos_beta            != null ? "--eps_pos_beta ${params.moire_eps_pos_beta}" : "",
            params.moire_eps_neg_alpha           != null ? "--eps_neg_alpha ${params.moire_eps_neg_alpha}" : "",
            params.moire_eps_neg_beta            != null ? "--eps_neg_beta ${params.moire_eps_neg_beta}" : "",
            params.moire_r_alpha                 != null ? "--r_alpha ${params.moire_r_alpha}" : "",
            params.moire_r_beta                  != null ? "--r_beta ${params.moire_r_beta}" : "",
            params.moire_mean_coi_shape          != null ? "--mean_coi_shape ${params.moire_mean_coi_shape}" : "",
            params.moire_mean_coi_scale          != null ? "--mean_coi_scale ${params.moire_mean_coi_scale}" : "",
            params.moire_max_eps_pos             != null ? "--max_eps_pos ${params.moire_max_eps_pos}" : "",
            params.moire_max_eps_neg             != null ? "--max_eps_neg ${params.moire_max_eps_neg}" : "",
            params.moire_record_latent_genotypes != null ? "--record_latent_genotypes ${params.moire_record_latent_genotypes}" : "",
            params.moire_pt_chains               != null ? "--pt_chains ${params.moire_pt_chains}" : "",
            params.moire_pt_grad_lower           != null ? "--pt_grad_lower ${params.moire_pt_grad_lower}" : "",
            params.moire_pt_num_threads          != null ? "--pt_num_threads ${params.moire_pt_num_threads}" : "",
            params.moire_adapt_temp              != null ? "--adapt_temp ${params.moire_adapt_temp}" : "",
            params.moire_max_runtime             != null ? "--max_runtime ${params.moire_max_runtime}" : ""
        ].findAll { arg -> arg }.join(" ")
        }
    }

    withName: 'DCIFER_IBD' {
        ext.args = { [
            params.dcifer_rnull != null ? "--rnull ${params.dcifer_rnull}" : "",
            params.dcifer_alpha != null ? "--alpha ${params.dcifer_alpha}" : "",
            params.dcifer_use_estm ? "--use_estm" : ""
        ].findAll { arg -> arg }.join(" ")
        }
    }
}
